# Optional. When these are empty, Clip Agent picks moments with heuristics.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local transcription when a video has no captions.
# "tiny" or "base" is the practical choice on a small host. The first run downloads the model.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Where jobs, renders, and the whisper model are stored.
DATA_DIR=./data

# Refuse videos longer than this so a small server can finish.
MAX_DURATION_SECONDS=1800
