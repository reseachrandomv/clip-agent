# Optional. When set, moments are scored by an OpenAI-compatible chat model.
# Leave it blank to use the built-in heatmap and transcript heuristics.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# faster-whisper model used only when the video has no YouTube captions.
# tiny is the practical choice on a 1GB host. base is a better default locally.
WHISPER_MODEL=base

# Refuse videos longer than this so a small machine can finish.
MAX_DURATION_SEC=1200

# Upload limit for the "bring your own file" path.
MAX_UPLOAD_MB=500

# Where jobs, source files, and clips are written.
DATA_DIR=./data

# ffmpeg x264 preset. veryfast is a good default; ultrafast is for tests.
RENDER_PRESET=veryfast

# How many jobs render at once. Keep this at 1 on a small VPS.
CLIP_WORKERS=1

# Stop a YouTube download that never returns (common when a datacenter IP is challenged).
DOWNLOAD_TIMEOUT_SEC=300

PORT=8000
